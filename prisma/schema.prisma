// Prisma Schema for HAVENHUB (Property Rental & Real Estate Marketplace)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PROPERTY_SEEKER
  LANDLORD
  REAL_ESTATE_AGENT
  PROPERTY_MANAGER
  ADMIN
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  RENTED
}

enum EnquiryStatus {
  PENDING
  REPLIED
  CLOSED
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

model User {
  id               String          @id @default(uuid())
  email            String          @unique
  passwordHash     String
  firstName        String
  lastName         String
  phoneNumber      String?
  role             Role            @default(PROPERTY_SEEKER)
  isVerified       Boolean         @default(false)
  avatarUrl        String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  // Relations
  listings         Property[]      @relation("LandlordListings")
  enquiriesSent    Enquiry[]       @relation("SeekerEnquiries")
  savedProperties  SavedProperty[]
  auditLogs        AuditLog[]      @relation("AdminAuditLogs")
  reportsSubmitted Report[]        @relation("ReporterUser")

  @@map("users")
}

model Property {
  id              String        @id @default(uuid())
  title           String
  description     String
  price           Float
  currency        String        @default("NGN")
  location        String
  address         String?
  city            String
  state           String
  propertyType    String        // e.g. Apartment, House, Duplex, Studio
  bedrooms        Int
  bathrooms       Int
  amenities       String[]      @default([])
  images          String[]      @default([])
  status          ListingStatus @default(PENDING_REVIEW)
  rejectionReason String?
  landlordId      String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  landlord        User          @relation("LandlordListings", fields: [landlordId], references: [id], onDelete: Cascade)
  enquiries       Enquiry[]
  savedBy         SavedProperty[]

  @@map("properties")
}

model Enquiry {
  id          String        @id @default(uuid())
  message     String
  status      EnquiryStatus @default(PENDING)
  propertyId  String
  seekerId    String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relations
  property    Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  seeker      User          @relation("SeekerEnquiries", fields: [seekerId], references: [id], onDelete: Cascade)

  @@map("enquiries")
}

model SavedProperty {
  id          String   @id @default(uuid())
  userId      String
  propertyId  String
  createdAt   DateTime @default(now())

  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@map("saved_properties")
}

model Report {
  id          String       @id @default(uuid())
  reporterId  String
  targetType  String       // "PROPERTY", "USER", "ENQUIRY"
  targetId    String
  reason      String
  details     String?
  status      ReportStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  reporter    User         @relation("ReporterUser", fields: [reporterId], references: [id], onDelete: Cascade)

  @@map("reports")
}

model AuditLog {
  id        String   @id @default(uuid())
  adminId   String
  action    String   // e.g. "APPROVE_LISTING", "REJECT_LISTING", "SUSPEND_USER"
  details   String
  createdAt DateTime @default(now())

  // Relations
  admin     User     @relation("AdminAuditLogs", fields: [adminId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}
